DISCORD_TOKEN=replace_me
DISCORD_GUILD_ID=replace_me
DISCORD_VOICE_CHANNEL_ID=replace_me
DISCORD_TEXT_CHANNEL_ID=replace_me
# Grant reviewer/publisher access in Discord with /vera access (Manage Server required).
RECORDINGS_DIR=./data
# Issue drafts are generated directly in this language; source quotes stay original.
ISSUE_LANGUAGE=English
# ollama keeps text local; claude sends transcript/context to Anthropic (paid API).
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
STT_RUN=live
# Recommended defaults for Swedish. Choose a compatible model and language for other speech.
STT_MODEL=KBLab/kb-whisper-small
STT_LANGUAGE=sv
# Optional: leave both blank to disable GitHub (recording and draft review still work).
# If configured, startup verifies connectivity and Issues read/write access or fails.
# Use a repository-scoped token with Issues read/write access.
GITHUB_REPO=
GITHUB_TOKEN=
